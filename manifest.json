{
  "manifest_version": 3,
  "name": "Poshmark Refine",
  "version": "0.10.1",
  "description": "Makes Poshmark search respect the size, brand and colour you asked for. Works only on the page you loaded; sends nothing anywhere.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://poshmark.com/*",
    "https://vuoriclothing.com/*"
  ],
  "background": {
    "service_worker": "extension/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://poshmark.com/search*",
        "https://poshmark.com/category/*",
        "https://poshmark.com/brand/*"
      ],
      "js": [
        "extension/content.js"
      ],
      "css": [
        "extension/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vuoriclothing.com/products/*",
        "https://www.vuoriclothing.com/products/*"
      ],
      "js": [
        "extension/brand.js"
      ],
      "css": [
        "extension/brand.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core/normalize.js",
        "core/verdict.js",
        "core/grid.js"
      ],
      "matches": [
        "https://poshmark.com/*"
      ]
    },
    {
      "resources": [
        "core/brand.js",
        "core/search.js"
      ],
      "matches": [
        "https://vuoriclothing.com/*",
        "https://www.vuoriclothing.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "extension/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Poshmark Refine",
    "default_popup": "extension/popup.html"
  }
}
